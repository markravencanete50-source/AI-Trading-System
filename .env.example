# The one Google account allowed to sign in. Must match firestore.rules.
OWNER_EMAIL=you@gmail.com
NEXT_PUBLIC_OWNER_EMAIL=you@gmail.com

# Firebase web app config (Project settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key with literal \n sequences, the code converts them.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Alpaca (only if you connect an Alpaca broker). Keep paper until the scorecard earns trust.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_FEED=iex

# Cron + webhook secrets (long random strings)
CRON_SECRET=
WEBHOOK_SECRET=

# Email alerts (Gmail: 2FA on, then an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Public URL used in alert emails
APP_URL=https://your-app.vercel.app
